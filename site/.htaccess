# --- Ganze Bereiche: Beiträge, Archive, Anlässe
RewriteRule ^(19|20)\d\d/ https://www.ttc-neuhausen.ch/news.html [R=301,L]
RewriteRule ^(category|tag|author)/ https://www.ttc-neuhausen.ch/news.html [R=301,L]
RewriteRule ^page/\d+/?$ https://www.ttc-neuhausen.ch/news.html [R=301,L]
RewriteRule ^event/ https://www.ttc-neuhausen.ch/verein-jahresprogramm.html [R=301,L]
RewriteRule ^calendar/ https://www.ttc-neuhausen.ch/verein-jahresprogramm.html [R=301,L]
RewriteRule ^pdfviewer/ https://www.ttc-neuhausen.ch/verein-downloads.html [R=301,L]
RewriteRule ^wp-sitemap.*\.xml$ https://www.ttc-neuhausen.ch/sitemap.xml [R=301,L]

# --- Eine einzige Adresse: https://www.ttc-neuhausen.ch/
RewriteCond %{HTTP_HOST} ^ttc\-neuhausen\.ch$ [NC]
RewriteRule ^ https://www.ttc-neuhausen.ch%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^www\.ttc\-neuhausen\.ch$ [NC]
RewriteRule ^ https://www.ttc-neuhausen.ch%{REQUEST_URI} [R=301,L,NE]

# index.html nicht als zweite Adresse der Startseite
RewriteCond %{THE_REQUEST} ^[A-Z]+\s[^?\s]*/index\.html[?\s]
RewriteRule ^(.*/)?index\.html$ https://www.ttc-neuhausen.ch/$1 [R=301,L]

# --- /training statt /training.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ https://www.ttc-neuhausen.ch/$1.html [R=301,L]

# Browser fragen von sich aus nach /favicon.ico
RewriteRule ^favicon\.ico$ /assets/img/favicon-512.png [L]
</IfModule>

# --- Schneller laden: Google misst die Ladezeit mit
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/ld+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Seiten, CSS und JavaScript jedes Mal nachfragen (304, wenn unverändert),
  # damit nach einem neuen Build niemand alte Teile sieht.
  <FilesMatch "\.(html|css|js|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Bilder werden unter gleichem Namen ersetzt – eine Woche.
  <FilesMatch "\.(jpe?g|png|webp|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(pdf|docx|xlsx)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
