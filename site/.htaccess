RewriteRule ^wp\-content/uploads/2025/10/Beitrittserklaerungen\-AktivPlus\-Studenten\-und\-Lehrling\.pdf$ https://www.ttc-neuhausen.ch/assets/dokumente/beitritt-aktivplus-studenten.pdf [R=301,L]
RewriteRule ^wp\-content/uploads/2025/10/Beitrittserklaerungen\-AktivPlus\-Senioren\.pdf$ https://www.ttc-neuhausen.ch/assets/dokumente/beitritt-aktivplus-senioren.pdf [R=301,L]
RewriteRule ^wp\-content/uploads/2025/10/Beitrittserklaerungen\-Aktiv\.pdf$ https://www.ttc-neuhausen.ch/assets/dokumente/beitritt-aktiv.pdf [R=301,L]
RewriteRule ^wp\-content/uploads/2025/10/Beitrittserklaerungen\-Damenverein\.pdf$ https://www.ttc-neuhausen.ch/assets/dokumente/beitritt-damenverein.pdf [R=301,L]
