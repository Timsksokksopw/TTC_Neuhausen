RewriteRule ^wp\-content/uploads/2024/05/TTZ\-Ebnat\-_Hallentarife\.pdf$ https://www.ttc-neuhausen.ch/assets/dokumente/hallentarife-ttz-ebnat.pdf [R=301,L]
