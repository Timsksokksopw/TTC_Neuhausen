# .htaccess – ERZEUGT VON build.py, nicht von Hand ändern.
# Weiterleitungen: vorlage/seo.py. Danach einmal build.py.
#
# Gehört in denselben Ordner wie index.html. Beim Hochladen per FTP
# mitnehmen: viele Programme blenden Dateien mit Punkt vorne aus.

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
AddDefaultCharset utf-8
AddType font/woff2 .woff2
AddType image/webp .webp

<IfModule mod_rewrite.c>
RewriteEngine On

# Die Fehlerseite, die Apache nach 404 oder 410 intern nachlädt, nicht
# anfassen – sonst wird aus «410 Gone» eine Weiterleitung auf 404.html.
RewriteCond %{ENV:REDIRECT_STATUS} ^[45][0-9][0-9]$
RewriteRule ^ - [L]

# Alte Adressen stehen vor der Regel für https und www: ihr Ziel ist
# schon absolut, so kommt jede in einem Schritt an.

# Ordner ohne index.html nicht auflisten
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

# --- Vorlagen des alten Themes und WordPress-Technik: 410 Gone
RewriteRule ^(sample\-page|sample\-page\-2|home\-2|home\-3|home\-4|order\-tracking|about\-us|services|full\-width|shortcodes|pricing\-tables|portfolio|portfolio\-with\-content|portoflio\-with\-slider|scenery\-portfolio|architecture\-portfolio|2\-columns|3\-columns|4\-columns|covid\-19\-massnahmen\-fuer\-nationalliga)/?$ - [G,L]
RewriteRule ^(portfolio|testimonial|filters|kwlogos-carousel)/ - [G,L]
RewriteRule ^(wp-admin|wp-includes|wp-json)(/|$) - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup)\.php$ - [G,L]
RewriteRule (^|/)(comments/)?feed/?$ - [G,L]

# --- Alte Kurzadressen von WordPress (?p=123, ?page_id=45, Suche)
RewriteCond %{QUERY_STRING} (^|&)(p|cat|tag|m|author)=
RewriteRule ^$ https://www.ttc-neuhausen.ch/news.html? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(page_id|s)=
RewriteRule ^$ https://www.ttc-neuhausen.ch/? [R=301,L]

# --- Dokumente der alten Website (vorlage/dokumente.py)
RewriteRule ^wp\-content/uploads/2026/01/Statuten_Ausgabe_2025_12\.pdf$ https://www.ttc-neuhausen.ch/assets/dokumente/statuten.pdf [R=301,L]
